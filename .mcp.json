{
  "mcpServers": {
    "nano-banana": {
      "command": "node",
      "args": ["projects/ffh-simplified/tools/nano-banana-mcp/dist/index.js"],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    },
    "openai-image": {
      "command": "node",
      "args": ["projects/openai-image-mcp/dist/index.js"],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY:-}",
        "NODE_USE_ENV_PROXY": "1"
      }
    }
  }
}
